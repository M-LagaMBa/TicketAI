{
  "manifest_version": 3,
  "name": "TicketAI",
  "description": "Classificação rápida de tickets no Hubspot via presets.",
  "version": "1.7",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "*://*.hubspot.com/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Abrir TicketAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.hubspot.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
